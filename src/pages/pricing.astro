---
import "../index.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { PRICING_RESOURCE_DEFAULTS } from "../data/pricing-data.js";

type LocaleCopy = { id: string; en: string };

const fallbackPricing = PRICING_RESOURCE_DEFAULTS;

const pageCopy: Record<string, LocaleCopy> = {
  "meta.description": {
    id: "Pricelist jasa pembuatan website Solivate Studio 2026: personal website, wedding invitation, website UMKM, e-commerce, business system, corporate website, government portal, dan custom software.",
    en: "Solivate Studio 2026 pricing list: personal websites, wedding invitations, SME websites, e-commerce, business systems, corporate websites, government portals, and custom software."
  },
  "nav.about": { id: "Tentang", en: "About" },
  "nav.services": { id: "Layanan", en: "Services" },
  "nav.pricing": { id: "Harga", en: "Pricing" },
  "nav.work": { id: "Karya", en: "Work" },
  "nav.process": { id: "Proses", en: "Process" },
  "nav.contact": { id: "Kontak", en: "Contact" },
  "nav.cta": { id: "Mulai Proyek", en: "Start Project" },
  "hero.eyebrow": { id: "Pricelist Layanan Solivate Studio 2026", en: "Solivate Studio 2026 Service Pricing" },
  "hero.title": { id: "Website, e-commerce, business system, dan custom software.", en: "Websites, e-commerce, business systems, and custom software." },
  "hero.lead": {
    id: "Solivate Studio membantu individu, organisasi, UMKM, perusahaan, dan instansi membangun produk digital sesuai kebutuhan aktual, mulai dari website sederhana hingga software operasional khusus.",
    en: "Solivate Studio helps individuals, organizations, SMEs, companies, and institutions build digital products around real operational needs, from simple websites to tailored software."
  },
  "hero.note": {
    id: "Seluruh harga adalah harga awal untuk scope representatif. Final quotation disusun setelah kebutuhan, fitur, timeline, dan skala project dikonfirmasi.",
    en: "All prices are starting prices for representative scopes. Final quotations are prepared after requirements, features, timeline, and project scale are confirmed."
  },
  "quote.label": { id: "Mulai dari", en: "Starting from" },
  "quote.cta": { id: "Konsultasi Gratis", en: "Free Consultation" },
  "summary.eyebrow": { id: "Ringkasan Harga", en: "Price Summary" },
  "summary.title": { id: "Kategori layanan utama untuk 2026.", en: "Core service categories for 2026." },
  "summary.personal": { id: "Personal & Non-Profit", en: "Personal & Non-Profit" },
  "summary.business": { id: "UMKM & Growing Business", en: "SME & Growing Business" },
  "summary.enterprise": { id: "Business & Enterprise", en: "Business & Enterprise" },
  "section.personal.eyebrow": { id: "01 / Personal & Non-Profit", en: "01 / Personal & Non-Profit" },
  "section.personal.title": { id: "Website personal, undangan, dan platform institusi yang lebih rapi dan kredibel.", en: "Personal sites, digital invitations, and institution platforms with clearer structure and stronger credibility." },
  "section.personal.lead": { id: "Untuk personal brand, celebration, komunitas, yayasan, masjid, sekolah kecil, dan lembaga non-profit yang ingin hadir profesional di ranah digital.", en: "For personal brands, celebrations, communities, foundations, mosques, small schools, and non-profits that need a professional digital presence." },
  "section.business.eyebrow": { id: "02 / UMKM & Growing Business", en: "02 / SME & Growing Business" },
  "section.business.title": { id: "Website promosi, e-commerce, event platform, dan sistem bisnis yang mendukung operasional.", en: "Promotional websites, e-commerce, event platforms, and business systems that support day-to-day operations." },
  "section.business.lead": { id: "Untuk UMKM, bisnis bertumbuh, event organizer, retail, brand lokal, dan tim operasional yang butuh software kerja yang lebih terstruktur.", en: "For SMEs, growing businesses, event teams, retail, local brands, and operations teams that need more structured working software." },
  "section.enterprise.eyebrow": { id: "03 / Business & Enterprise", en: "03 / Business & Enterprise" },
  "section.enterprise.title": { id: "Corporate website, public portal, dan workflow digital berskala organisasi.", en: "Corporate websites, public portals, and digital workflows at organizational scale." },
  "section.enterprise.lead": { id: "Untuk perusahaan, instansi, unit pemerintah, dan organisasi yang membutuhkan sistem lebih formal, terdokumentasi, dan terintegrasi.", en: "For companies, institutions, government units, and organizations that need more formal, documented, and integrated systems." },
  "custom.eyebrow": { id: "04 / Custom Software & Enterprise Solution", en: "04 / Custom Software & Enterprise Solution" },
  "custom.title": { id: "Untuk scope besar, kompleks, dan tidak aman dipaketkan secara generik.", en: "For large, complex scopes that are not safe to package generically." },
  "custom.lead": { id: "Cocok untuk ERP, SaaS, multi-tenant platform, marketplace, mobile app, sistem terintegrasi lintas unit, atau platform high-scale lainnya.", en: "Suitable for ERP, SaaS, multi-tenant platforms, marketplaces, mobile apps, cross-unit integrated systems, and other high-scale platforms." },
  "info.eyebrow": { id: "Informasi Tambahan", en: "Additional Information" },
  "info.title": { id: "Hal-hal yang perlu dipahami sebelum final quotation disusun.", en: "Things to understand before the final quotation is prepared." },
  "info.domain.title": { id: "Domain, Hosting, & SSL", en: "Domain, Hosting, & SSL" },
  "info.domain.body": { id: "Project senilai Rp400.000 atau di bawahnya menggunakan subdomain Solivate atau domain milik client. Domain umum dapat di-include sesuai paket, kebijakan, dan biaya registrar. Domain khusus atau premium dapat menjadi biaya terpisah.", en: "Projects worth Rp400,000 or below use a Solivate subdomain or a client-owned domain. Common domains may be included depending on package policy and registrar cost. Special or premium domains can become separate costs." },
  "info.third.title": { id: "Biaya Pihak Ketiga", en: "Third-Party Costs" },
  "info.third.body": { id: "MDR, settlement fee, subscription provider, transaction fee, shipping API, WhatsApp provider, dan biaya layanan pihak ketiga tidak termasuk kecuali dinyatakan included secara tertulis dalam proposal.", en: "MDR, settlement fees, provider subscriptions, transaction fees, shipping APIs, WhatsApp providers, and other third-party service costs are excluded unless explicitly stated as included in the proposal." },
  "info.scope.title": { id: "Bagaimana Harga Final Ditentukan?", en: "How Is the Final Price Determined?" },
  "info.scope.body": { id: "Harga final dipengaruhi jumlah halaman atau modul, fitur dan integrasi, jumlah user dan role, workflow, volume data, traffic, timeline urgent, support, maintenance, SLA, dan biaya provider terkait.", en: "Final pricing is influenced by page or module count, features and integrations, number of users and roles, workflow complexity, data volume, traffic, urgent timelines, support, maintenance, SLA, and relevant provider costs." },
  "info.disclaimer.title": { id: "Disclaimer", en: "Disclaimer" },
  "info.disclaimer.body": { id: "Harga yang ditampilkan adalah harga awal untuk scope representatif. Final quotation dapat berubah berdasarkan kebutuhan aktual client dan hasil discovery singkat bersama tim Solivate Studio.", en: "Displayed prices are starting prices for representative scopes. Final quotations may change based on actual client needs and the short discovery process with the Solivate Studio team." },
  "flow.eyebrow": { id: "Alur Pemesanan", en: "Ordering Flow" },
  "flow.title": { id: "Cara project berjalan dari konsultasi sampai pengerjaan.", en: "How projects move from consultation to execution." },
  "flow.0.title": { id: "Konsultasi singkat", en: "Short consultation" },
  "flow.0.body": { id: "Client menjelaskan kebutuhan, objective, dan konteks project.", en: "The client explains the need, objective, and project context." },
  "flow.1.title": { id: "Pemilihan solusi", en: "Solution selection" },
  "flow.1.body": { id: "Tim Solivate merekomendasikan paket awal yang paling sesuai.", en: "The Solivate team recommends the most suitable starting package." },
  "flow.2.title": { id: "Konfirmasi scope", en: "Scope confirmation" },
  "flow.2.body": { id: "Fitur, deliverable, timeline, dan batasan project disepakati bersama.", en: "Features, deliverables, timeline, and project boundaries are aligned together." },
  "flow.3.title": { id: "Quotation final", en: "Final quotation" },
  "flow.3.body": { id: "Client menerima penawaran harga final sesuai scope aktual.", en: "The client receives a final quotation based on the actual scope." },
  "flow.4.title": { id: "Pengerjaan", en: "Execution" },
  "flow.4.body": { id: "Project dimulai sesuai timeline dan termin pembayaran yang disepakati.", en: "The project starts based on the agreed timeline and payment terms." },
  "cta.title": { id: "Right Scope. Right Capability. Right Price.", en: "Right Scope. Right Capability. Right Price." },
  "cta.body": { id: "Kalau kebutuhan project Anda belum pas masuk paket tertentu, kami bantu mapping supaya scope dan quotation tetap realistis.", en: "If your project does not neatly fit a package, we will help map it so the scope and quotation remain realistic." },
  "cta.button": { id: "Diskusikan Project", en: "Discuss Your Project" },
  "footer.title": { id: "Bangun sesuatu yang orang ingat.", en: "Let's build something people remember." },
  "footer.cta": { id: "Mulai Proyek", en: "Start Project" },
  "footer.desc": { id: "Digital solution provider untuk UMKM, komunitas sosial, event, celebration, dan sistem custom yang ingin naik kelas secara digital.", en: "Digital solution provider for SMEs, social communities, events, celebrations, and custom systems ready to level up digitally." },
  "footer.nav": { id: "Navigasi", en: "Navigation" },
  "footer.connect": { id: "Kontak", en: "Connect" },
  "footer.legal": { id: "Kebijakan", en: "Policies" },
  "footer.privacy": { id: "Kebijakan Privasi", en: "Privacy Policy" },
  "footer.terms": { id: "Syarat & Ketentuan", en: "Terms & Conditions" },
  "footer.revision": { id: "Kebijakan Revisi", en: "Revision Policy" },
  "footer.top": { id: "Kembali ke atas", en: "Back to top" },
  "footer.copy": { id: `Copyright ${new Date().getFullYear()} Solivate Studio. Semua hak dilindungi.`, en: `Copyright ${new Date().getFullYear()} Solivate Studio. All rights reserved.` },
  "floating.wa": { id: "Konsultasi sekarang, gratis!", en: "Free consultation now!" }
};

const tx = (key: string) => pageCopy[key]?.id ?? key;
const pricingI18nJson = JSON.stringify(pageCopy);
const fallbackPricingJson = JSON.stringify(fallbackPricing);
const siteUrl = "https://solivate.com";
const gaId = import.meta.env.PUBLIC_GA_ID || "G-H1R8S8W5W6";
const pricingUrl = `${siteUrl}/pricing`;
const pageTitle = "Pricelist Jasa Website, E-Commerce, & Custom Software | Solivate Studio";
const pageDescription = tx("meta.description");
const priceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Pricelist Layanan Solivate Studio 2026",
  provider: {
    "@type": "Organization",
    name: "Solivate Studio",
    url: siteUrl,
    logo: `${siteUrl}/solivate-logo.webp`,
    sameAs: ["https://www.instagram.com/solivatestudio/"]
  },
  areaServed: "Indonesia",
  serviceType: "Website Development, E-Commerce, Business System, Custom Software",
  description: pageDescription,
  offers: {
    "@type": "AggregateOffer",
    lowPrice: "199000",
    highPrice: "10000000",
    priceCurrency: "IDR",
    offerCount: String(fallbackPricing.length)
  }
});

const flowSteps = ["0", "1", "2", "3", "4"];

const byGroup = (group: string) => fallbackPricing.filter((item) => item.data.group === group);
const personalPlans = byGroup("personal");
const businessPlans = byGroup("business");
const enterprisePlans = byGroup("enterprise");
const customPlan = fallbackPricing.find((item) => item.data.group === "custom");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="pricelist website 2026, jasa pembuatan website, harga website UMKM, harga website company profile, harga wedding invitation, harga ecommerce, harga custom software, business system, corporate website, government website, Solivate Studio" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pricingUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solivate Studio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pricingUrl} />
    <meta property="og:image" content={`${siteUrl}/solivate-logo.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/solivate-logo.webp`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <Header i18n />

    <main class="pricing-page">
      <section class="pricing-hero">
        <div class="hero-bg"></div>
        <div class="container pricing-hero-grid">
          <div>
            <p class="eyebrow" data-i18n="hero.eyebrow">{tx("hero.eyebrow")}</p>
            <h1 data-i18n="hero.title">{tx("hero.title")}</h1>
            <p class="hero-text" data-i18n="hero.lead">{tx("hero.lead")}</p>
            <p class="pricing-hero-note" data-i18n="hero.note">{tx("hero.note")}</p>
          </div>
          <div class="pricing-quote-card">
            <span data-i18n="quote.label">{tx("quote.label")}</span>
            <div class="pricing-min-price" data-min-price>Rp199.000+</div>
            <p data-i18n="hero.note">{tx("hero.note")}</p>
            <a class="btn-primary" href="https://wa.me/6281219118993" target="_blank" rel="noreferrer" data-whatsapp-cta>
              <span data-i18n="quote.cta">{tx("quote.cta")}</span>
              <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg>
            </a>
          </div>
        </div>
      </section>

      <section class="section light pricing-summary-section">
        <div class="container section-head">
          <p class="eyebrow" data-i18n="summary.eyebrow">{tx("summary.eyebrow")}</p>
          <h2 data-i18n="summary.title">{tx("summary.title")}</h2>
        </div>
        <div class="container pricing-summary-grid">
          <article class="pricing-summary-card" data-summary-group="personal">
            <span class="pricing-label" data-i18n="summary.personal">{tx("summary.personal")}</span>
            <div class="pricing-summary-table">
              {personalPlans.map((item) => (
                <div class="pricing-summary-row">
                  <span>{item.data.name_id}</span>
                  <strong>{item.data.price_id}</strong>
                </div>
              ))}
            </div>
          </article>
          <article class="pricing-summary-card" data-summary-group="business">
            <span class="pricing-label" data-i18n="summary.business">{tx("summary.business")}</span>
            <div class="pricing-summary-table">
              {businessPlans.map((item) => (
                <div class="pricing-summary-row">
                  <span>{item.data.name_id}</span>
                  <strong>{item.data.price_id}</strong>
                </div>
              ))}
            </div>
          </article>
          <article class="pricing-summary-card" data-summary-group="enterprise">
            <span class="pricing-label" data-i18n="summary.enterprise">{tx("summary.enterprise")}</span>
            <div class="pricing-summary-table">
              {enterprisePlans.map((item) => (
                <div class="pricing-summary-row">
                  <span>{item.data.name_id}</span>
                  <strong>{item.data.price_id}</strong>
                </div>
              ))}
              {customPlan && (
                <div class="pricing-summary-row">
                  <span>{customPlan.data.name_id}</span>
                  <strong>{customPlan.data.price_id}</strong>
                </div>
              )}
            </div>
          </article>
        </div>
      </section>

      <section class="section light">
        <div class="container section-head split">
          <div>
            <p class="eyebrow" data-i18n="section.personal.eyebrow">{tx("section.personal.eyebrow")}</p>
            <h2 data-i18n="section.personal.title">{tx("section.personal.title")}</h2>
          </div>
          <p class="lead" data-i18n="section.personal.lead">{tx("section.personal.lead")}</p>
        </div>
        <div class="container pricing-detail-grid compact" data-group-grid="personal">
          {personalPlans.map((item) => (
            <article class={`pricing-detail-card ${item.data.featured ? "featured" : ""}`}>
              <span class="pricing-label">{item.data.badge_id}</span>
              <h3>{item.data.name_id}</h3>
              <strong>{item.data.price_id}</strong>
              <p>{item.data.description_id}</p>
              <ul>
                {item.data.features_id.map((feature) => <li>{feature}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section pricing-detail-band">
        <div class="container section-head split">
          <div>
            <p class="eyebrow" data-i18n="section.business.eyebrow">{tx("section.business.eyebrow")}</p>
            <h2 data-i18n="section.business.title">{tx("section.business.title")}</h2>
          </div>
          <p class="lead" data-i18n="section.business.lead">{tx("section.business.lead")}</p>
        </div>
        <div class="container pricing-detail-grid" data-group-grid="business">
          {businessPlans.map((item) => (
            <article class={`pricing-detail-card business ${item.data.featured ? "featured" : ""}`}>
              <span class="pricing-label">{item.data.badge_id}</span>
              <h3>{item.data.name_id}</h3>
              <strong>{item.data.price_id}</strong>
              <p>{item.data.description_id}</p>
              <ul>
                {item.data.features_id.map((feature) => <li>{feature}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section light">
        <div class="container section-head split">
          <div>
            <p class="eyebrow" data-i18n="section.enterprise.eyebrow">{tx("section.enterprise.eyebrow")}</p>
            <h2 data-i18n="section.enterprise.title">{tx("section.enterprise.title")}</h2>
          </div>
          <p class="lead" data-i18n="section.enterprise.lead">{tx("section.enterprise.lead")}</p>
        </div>
        <div class="container pricing-detail-grid compact" data-group-grid="enterprise">
          {enterprisePlans.map((item) => (
            <article class={`pricing-detail-card ${item.data.featured ? "featured" : ""}`}>
              <span class="pricing-label">{item.data.badge_id}</span>
              <h3>{item.data.name_id}</h3>
              <strong>{item.data.price_id}</strong>
              <p>{item.data.description_id}</p>
              <ul>
                {item.data.features_id.map((feature) => <li>{feature}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      {customPlan && (
        <section class="section dark custom-pricing">
          <div class="container custom-pricing-grid">
            <div>
              <p class="eyebrow" data-i18n="custom.eyebrow">{tx("custom.eyebrow")}</p>
              <h2 data-i18n="custom.title">{tx("custom.title")}</h2>
              <p class="lead" data-i18n="custom.lead">{tx("custom.lead")}</p>
            </div>
            <div class="custom-price-box" data-custom-box>
              <span>{customPlan.data.badge_id}</span>
              <strong>{customPlan.data.price_id}</strong>
              <p>{customPlan.data.description_id}</p>
            </div>
          </div>
          <div class="container custom-feature-grid" data-custom-features>
            {customPlan.data.features_id.map((feature) => (
              <article>
                <span></span>
                <p>{feature}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="section light pricing-info-section">
        <div class="container section-head">
          <p class="eyebrow" data-i18n="info.eyebrow">{tx("info.eyebrow")}</p>
          <h2 data-i18n="info.title">{tx("info.title")}</h2>
        </div>
        <div class="container pricing-info-grid">
          <article class="pricing-note-card">
            <h3 data-i18n="info.domain.title">{tx("info.domain.title")}</h3>
            <p data-i18n="info.domain.body">{tx("info.domain.body")}</p>
          </article>
          <article class="pricing-note-card">
            <h3 data-i18n="info.third.title">{tx("info.third.title")}</h3>
            <p data-i18n="info.third.body">{tx("info.third.body")}</p>
          </article>
          <article class="pricing-note-card">
            <h3 data-i18n="info.scope.title">{tx("info.scope.title")}</h3>
            <p data-i18n="info.scope.body">{tx("info.scope.body")}</p>
          </article>
          <article class="pricing-note-card">
            <h3 data-i18n="info.disclaimer.title">{tx("info.disclaimer.title")}</h3>
            <p data-i18n="info.disclaimer.body">{tx("info.disclaimer.body")}</p>
          </article>
        </div>
      </section>

      <section class="section dark">
        <div class="container section-head">
          <p class="eyebrow" data-i18n="flow.eyebrow">{tx("flow.eyebrow")}</p>
          <h2 data-i18n="flow.title">{tx("flow.title")}</h2>
        </div>
        <div class="container process-grid pricing-flow-list">
          {flowSteps.map((step, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div class="card-title" data-i18n={`flow.${step}.title`}>{tx(`flow.${step}.title`)}</div>
              <p data-i18n={`flow.${step}.body`}>{tx(`flow.${step}.body`)}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section light">
        <div class="container pricing-cta-band">
          <div>
            <h2 data-i18n="cta.title">{tx("cta.title")}</h2>
            <p data-i18n="cta.body">{tx("cta.body")}</p>
          </div>
          <a class="btn-primary" href="/#contact">
            <span data-i18n="cta.button">{tx("cta.button")}</span>
            <svg class="arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg>
          </a>
        </div>
      </section>
    </main>

    <Footer i18n />

    <script is:inline type="application/ld+json" set:html={priceSchema}></script>
    <script is:inline type="application/json" id="pricing-i18n-data" set:html={pricingI18nJson}></script>
    <script is:inline type="application/json" id="pricing-fallback-data" set:html={fallbackPricingJson}></script>
    <script is:inline>
      const translations = JSON.parse(document.getElementById("pricing-i18n-data")?.textContent || "{}");
      const fallbackPricing = JSON.parse(document.getElementById("pricing-fallback-data")?.textContent || "[]");
      const header = document.querySelector("[data-header]");
      let pricingItems = fallbackPricing;

      const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;"
      }[char]));
      const cmsText = (data, key, lang) => data?.[`${key}_${lang}`] || data?.[`${key}_id`] || data?.[key] || "";
      const cmsList = (data, key, lang) => Array.isArray(data?.[`${key}_${lang}`]) ? data[`${key}_${lang}`] : [];
      const groupItems = (group) => pricingItems.filter((item) => item?.data?.group === group);
      const campaignPrice = (value, lang, compact = false) => {
        const current = String(value || "");
        const settings = window.solivateCampaign;
        const digits = current.replace(/\D/g, "");
        if (!settings?.active || !digits || !Number(settings.discount_amount)) return `<strong>${escapeHtml(current)}</strong>`;
        const locale = lang === "en" ? "en-US" : "id-ID";
        const suffix = current.trim().endsWith("+") ? "+" : "";
        const previous = `Rp${(Number(digits) + Number(settings.discount_amount)).toLocaleString(locale)}${suffix}`;
        const saving = `Rp${Number(settings.discount_amount).toLocaleString(locale)}`;
        return `<div class="campaign-price${compact ? " compact" : ""}"><del>${escapeHtml(previous)}</del><strong class="campaign-current-price">${escapeHtml(current)}</strong>${compact ? "" : `<span class="campaign-promo-chip">${lang === "en" ? "SAVE" : "HEMAT"} ${saving}</span>`}</div>`;
      };

      const renderPlanCard = (item, lang, extraClass = "") => {
        const data = item?.data || {};
        const features = cmsList(data, "features", lang);
        const featuredClass = data.featured ? " featured" : "";
        return `<article class="pricing-detail-card ${extraClass}${featuredClass}">
          <span class="pricing-label">${escapeHtml(cmsText(data, "badge", lang))}</span>
          <h3>${escapeHtml(cmsText(data, "name", lang))}</h3>
          ${campaignPrice(cmsText(data, "price", lang), lang)}
          <p>${escapeHtml(cmsText(data, "description", lang))}</p>
          <ul>${features.map((feature) => `<li>${escapeHtml(feature)}</li>`).join("")}</ul>
        </article>`;
      };

      const renderSummaryCard = (group, lang, includeCustom = false) => {
        const items = groupItems(group);
        const custom = includeCustom ? pricingItems.find((item) => item?.data?.group === "custom") : null;
        const rows = [...items, ...(custom ? [custom] : [])];
        return rows.map((item) => {
          const data = item?.data || {};
          return `<div class="pricing-summary-row">
            <span>${escapeHtml(cmsText(data, "name", lang))}</span>
            ${campaignPrice(cmsText(data, "price", lang), lang, true)}
          </div>`;
        }).join("");
      };

      const parsePrice = (value) => {
        const digits = String(value || "").replace(/\D/g, "");
        return digits ? Number(digits) : Number.POSITIVE_INFINITY;
      };

      const renderPricing = (lang = document.documentElement.lang || "id") => {
        const activeLang = lang === "en" ? "en" : "id";
        const personalGrid = document.querySelector('[data-group-grid="personal"]');
        const businessGrid = document.querySelector('[data-group-grid="business"]');
        const enterpriseGrid = document.querySelector('[data-group-grid="enterprise"]');
        const summaryPersonal = document.querySelector('[data-summary-group="personal"] .pricing-summary-table');
        const summaryBusiness = document.querySelector('[data-summary-group="business"] .pricing-summary-table');
        const summaryEnterprise = document.querySelector('[data-summary-group="enterprise"] .pricing-summary-table');
        const minPriceNode = document.querySelector("[data-min-price]");
        const custom = pricingItems.find((item) => item?.data?.group === "custom");
        const customBox = document.querySelector("[data-custom-box]");
        const customFeatures = document.querySelector("[data-custom-features]");

        if (summaryPersonal) summaryPersonal.innerHTML = renderSummaryCard("personal", activeLang);
        if (summaryBusiness) summaryBusiness.innerHTML = renderSummaryCard("business", activeLang);
        if (summaryEnterprise) summaryEnterprise.innerHTML = renderSummaryCard("enterprise", activeLang, true);

        if (personalGrid) personalGrid.innerHTML = groupItems("personal").map((item) => renderPlanCard(item, activeLang)).join("");
        if (businessGrid) businessGrid.innerHTML = groupItems("business").map((item) => renderPlanCard(item, activeLang, "business")).join("");
        if (enterpriseGrid) enterpriseGrid.innerHTML = groupItems("enterprise").map((item) => renderPlanCard(item, activeLang)).join("");

        if (custom && customBox) {
          const data = custom.data || {};
          customBox.innerHTML = `<span>${escapeHtml(cmsText(data, "badge", activeLang))}</span><strong>${escapeHtml(cmsText(data, "price", activeLang))}</strong><p>${escapeHtml(cmsText(data, "description", activeLang))}</p>`;
        }
        if (custom && customFeatures) {
          const data = custom.data || {};
          customFeatures.innerHTML = cmsList(data, "features", activeLang).map((feature) => `<article><span></span><p>${escapeHtml(feature)}</p></article>`).join("");
        }

        const visiblePrices = pricingItems
          .filter((item) => item?.data?.group !== "custom")
          .map((item) => parsePrice(cmsText(item.data, "price", activeLang)))
          .filter((value) => Number.isFinite(value));

        if (minPriceNode && visiblePrices.length) {
          const min = Math.min(...visiblePrices);
          const current = `Rp${min.toLocaleString(activeLang === "en" ? "en-US" : "id-ID")}+`;
          minPriceNode.innerHTML = campaignPrice(current, activeLang);
        }
      };

      const updateHeader = () => {
        const y = Math.max(0, window.scrollY);
        header?.classList.toggle("is-scrolled", y > 24);
        header?.classList.toggle("is-compact", y > 64);
      };
      window.addEventListener("scroll", updateHeader, { passive: true });
      updateHeader();

      const setLanguage = (lang, persist = false) => {
        const activeLang = lang === "en" ? "en" : "id";
        document.documentElement.lang = activeLang;
        if (persist) {
          window.localStorage.setItem("solivate-language", activeLang);
          window.localStorage.setItem("solivate-language-manual", "true");
        }
        document.querySelectorAll("[data-i18n]").forEach((node) => {
          const key = node.getAttribute("data-i18n");
          const next = translations[key]?.[activeLang];
          if (next) node.textContent = next;
        });
        document.querySelectorAll("[data-lang-switch]").forEach((button) => {
          const active = button.getAttribute("data-lang-switch") === activeLang;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
        renderPricing(activeLang);
      };

      document.querySelectorAll("[data-lang-switch]").forEach((button) => {
        button.addEventListener("click", () => setLanguage(button.getAttribute("data-lang-switch"), true));
      });

      const savedLanguage = window.localStorage.getItem("solivate-language-manual") === "true"
        ? window.localStorage.getItem("solivate-language")
        : "id";
      setLanguage(savedLanguage || "id");

      fetch("/api/public/content?type=pricing", { cache: "no-store" })
        .then((response) => response.ok ? response.json() : null)
        .then((data) => {
          pricingItems = data?.resources?.pricing?.length ? data.resources.pricing : fallbackPricing;
          renderPricing(document.documentElement.lang);
        })
        .catch(() => {
          pricingItems = fallbackPricing;
          renderPricing(document.documentElement.lang);
        });

      fetch("/api/public/cms", { cache: "no-store" })
        .then((response) => response.ok ? response.json() : null)
        .then((data) => {
          const whatsapp = String(data?.entries?.contact_whatsapp || "").replace(/\D/g, "");
          if (!whatsapp) return;
          const text = encodeURIComponent("Halo Solivate Studio, saya mau konsultasi gratis untuk project website.");
          document.querySelectorAll("[data-whatsapp-cta]").forEach((node) => {
            node.href = `https://wa.me/${whatsapp}?text=${text}`;
          });
        })
        .catch(() => {});

      window.addEventListener("solivate:campaign", () => renderPricing(document.documentElement.lang));

      document.querySelectorAll("[data-top]").forEach((trigger) => {
        trigger.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
      });
      document.querySelectorAll("[data-home-contact]").forEach((trigger) => {
        trigger.addEventListener("click", () => { window.location.href = "/#contact"; });
      });

      if (!window.matchMedia("(hover: none)").matches) {
        document.querySelectorAll(".btn-primary, .nav-cta, .pricing-detail-card, .pricing-summary-card, .pricing-note-card, .custom-feature-grid article").forEach((el) => {
          let frame = 0;
          const strength = el.matches(".btn-primary, .nav-cta") ? 0.12 : 0.035;
          el.addEventListener("mousemove", (event) => {
            const pointer = event;
            window.cancelAnimationFrame(frame);
            frame = window.requestAnimationFrame(() => {
              const rect = el.getBoundingClientRect();
              const x = (pointer.clientX - (rect.left + rect.width / 2)) * strength;
              const y = (pointer.clientY - (rect.top + rect.height / 2)) * strength;
              el.style.setProperty("--hover-x", `${x.toFixed(2)}px`);
              el.style.setProperty("--hover-y", `${y.toFixed(2)}px`);
            });
          });
          el.addEventListener("mouseleave", () => {
            window.cancelAnimationFrame(frame);
            el.style.setProperty("--hover-x", "0px");
            el.style.setProperty("--hover-y", "0px");
          });
        });
      }
    </script>
  </body>
</html>
