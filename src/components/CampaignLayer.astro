---
const { home = false } = Astro.props;

const defaults = {
  enabled: true,
  start_date: "2026-08-12",
  end_date: "2026-08-31",
  discount_amount: 81000,
  desktop_image: "/images/campaign/merdeka-81-desktop.webp",
  mobile_image: "/images/campaign/merdeka-81-mobile.webp",
  image_alt_id: "Kampanye Promo Merdeka Solivate Studio",
  image_alt_en: "Solivate Studio Independence Day promotion",
  eyebrow_id: "Promo Merdeka HUT RI ke-81",
  eyebrow_en: "Indonesia's 81st Independence Day",
  headline_id: "Merdeka bikin website. Hemat hingga Rp81.000.",
  headline_en: "Build your website and save up to Rp81,000.",
  description_id: "Rayakan kemerdekaan dengan langkah digital baru untuk bisnis, komunitas, atau momen spesialmu.",
  description_en: "Celebrate Independence Day with a new digital step for your business, community, or meaningful moment.",
  cta_id: "Klaim Promo via WhatsApp",
  cta_en: "Claim Promo via WhatsApp",
  whatsapp_message_id: "Halo Solivate Studio, saya tertarik dengan Promo Merdeka HUT RI ke-81 dan ingin konsultasi project.",
  whatsapp_message_en: "Hello Solivate Studio, I am interested in the 81st Independence Day promotion and would like to discuss a project."
};
const defaultsJson = JSON.stringify(defaults);
---

<div class="campaign-rail" data-campaign-rail hidden>
  <span class="campaign-flag" aria-hidden="true"><i></i><i></i></span>
  <p><b data-campaign-rail-title>Promo Merdeka HUT RI ke-81</b><span>Harga spesial hingga Rp81.000</span></p>
  <a href="/#pricing">Lihat promo <span aria-hidden="true">↗</span></a>
</div>

<div class="campaign-atmosphere" data-campaign-atmosphere aria-hidden="true" hidden>
  <div class="campaign-map-art">
    <img src="/images/campaign/indonesia-flag-map.webp" alt="" width="1280" height="469" />
    <span class="campaign-map-year"><b>81</b><small>1945—2026</small></span>
  </div>
  <div class="campaign-corner-flag">
    <img src="/images/campaign/indonesia-flag.svg" alt="" width="900" height="600" />
    <span>INDONESIA 81</span>
  </div>
  <canvas class="campaign-three-flag" data-campaign-three-flag width="360" height="240"></canvas>
  <span class="campaign-star star-one">✦</span>
  <span class="campaign-star star-two">✦</span>
  <div class="campaign-side-flags campaign-side-left">
    <span class="campaign-side-pole"></span>
    <span class="campaign-side-cloth">{Array.from({ length: 14 }).map((_, index) => <i style={`animation-delay:${index * -72}ms`}></i>)}</span>
    <b>17.08</b>
  </div>
  <div class="campaign-side-flags campaign-side-right">
    <span class="campaign-side-pole"></span>
    <span class="campaign-side-cloth">{Array.from({ length: 14 }).map((_, index) => <i style={`animation-delay:${index * -72}ms`}></i>)}</span>
    <b>81</b>
  </div>
  <div class="campaign-bunting" aria-hidden="true">
    {Array.from({ length: 18 }).map((_, index) => <i class={index % 2 ? "is-white" : "is-red"} style={`animation-delay:${index * -90}ms`}></i>)}
  </div>
  <div class="campaign-ribbon-banner">
    <i></i><strong>INDONESIA 81</strong><span>MERDEKA UNTUK BERKARYA</span><i></i>
  </div>
  <div class="campaign-pennants pennants-left">{Array.from({ length: 7 }).map((_, index) => <i style={`--p:${index}`}></i>)}</div>
  <div class="campaign-pennants pennants-right">{Array.from({ length: 7 }).map((_, index) => <i style={`--p:${index}`}></i>)}</div>
  <span class="campaign-rosette" data-campaign-rosette></span>
</div>

<div class="campaign-transition" data-campaign-transition hidden aria-hidden="true">
  <div class="campaign-transition-window campaign-transition-red">
    <div class="campaign-transition-track">
      {Array.from({ length: 2 }).map(() => (
        <div class="campaign-transition-group">
          <b>17.08</b><i></i><span>MERDEKA UNTUK BERKARYA</span><i></i><span>CREATE</span><i></i><span>BUILD</span><i></i><span>INDONESIA 81</span><i></i>
        </div>
      ))}
    </div>
  </div>
  <div class="campaign-transition-window campaign-transition-white">
    <div class="campaign-transition-track is-reverse">
      {Array.from({ length: 2 }).map(() => (
        <div class="campaign-transition-group">
          <b>81 YEARS</b><i></i><span>17 AGUSTUS 1945</span><i></i><span>DARI INDONESIA</span><i></i><span>UNTUK IDE YANG LEBIH BESAR</span><i></i>
        </div>
      ))}
    </div>
  </div>
</div>

{home && (
  <div class="campaign-popup-backdrop" data-campaign-popup hidden>
    <canvas class="campaign-confetti-canvas" data-campaign-confetti-canvas aria-hidden="true"></canvas>
    <section class="campaign-popup" role="dialog" aria-modal="true" aria-labelledby="campaign-popup-title">
      <button class="campaign-popup-close" type="button" data-campaign-close aria-label="Tutup promo">
        <span></span><span></span>
      </button>
      <picture class="campaign-popup-media">
        <source media="(max-width: 640px)" data-campaign-mobile-srcset />
        <img data-campaign-image src={defaults.desktop_image} alt={defaults.image_alt_id} width="1536" height="1024" />
      </picture>
      <div class="campaign-popup-copy">
        <div class="campaign-popup-mark" aria-hidden="true"><small>HUT RI</small><strong>81</strong><span>1945—2026</span></div>
        <p class="campaign-popup-eyebrow" data-campaign-eyebrow>{defaults.eyebrow_id}</p>
        <h2 id="campaign-popup-title" data-campaign-headline>{defaults.headline_id}</h2>
        <p data-campaign-description>{defaults.description_id}</p>
        <a class="campaign-popup-cta" data-campaign-cta href="#" target="_blank" rel="noreferrer">
          <span data-campaign-cta-label>{defaults.cta_id}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
)}

<script is:inline type="application/json" id="campaign-defaults" set:html={defaultsJson}></script>
<script>
  import party from "party-js";

  (window as Window & { solivateParty?: typeof party }).solivateParty = party;
  window.dispatchEvent(new CustomEvent("solivate:party-ready"));

  const setupThreeFlag = async () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-campaign-three-flag]");
    if (!canvas) return;
    const {
      CylinderGeometry,
      DoubleSide,
      Mesh,
      MeshBasicMaterial,
      OrthographicCamera,
      PlaneGeometry,
      Scene,
      ShaderMaterial,
      WebGLRenderer
    } = await import("three");
    const renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(canvas.clientWidth || 180, canvas.clientHeight || 120, false);
    const scene = new Scene();
    const camera = new OrthographicCamera(-.35, 2.8, 1.05, -1.05, .1, 10);
    camera.position.z = 4;
    const geometry = new PlaneGeometry(2.45, 1.5, 32, 18);
    geometry.translate(1.225, 0, 0);
    const uniforms = { time: { value: 0 } };
    const material = new ShaderMaterial({
      uniforms,
      transparent: true,
      side: DoubleSide,
      vertexShader: `
        uniform float time;
        varying vec2 vUv;
        void main() {
          vUv = uv;
          vec3 p = position;
          float grip = smoothstep(0.0, 0.16, uv.x);
          p.z += sin(p.x * 4.4 - time * 2.6) * 0.16 * grip;
          p.y += sin(p.x * 3.2 - time * 2.1) * 0.055 * grip;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(p, 1.0);
        }
      `,
      fragmentShader: `
        varying vec2 vUv;
        void main() {
          vec3 red = vec3(0.898, 0.137, 0.165);
          vec3 white = vec3(1.0);
          vec3 color = vUv.y > 0.5 ? red : white;
          float edge = smoothstep(0.0, .025, vUv.x) * smoothstep(0.0, .025, 1.0 - vUv.x);
          gl_FragColor = vec4(color, edge * .96);
        }
      `
    });
    scene.add(new Mesh(geometry, material));
    const pole = new Mesh(
      new CylinderGeometry(.025, .025, 2.05, 10),
      new MeshBasicMaterial({ color: 0xdce3ea })
    );
    pole.position.set(0, -.28, -.04);
    scene.add(pole);
    let frame = 0;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const render = (time: number) => {
      const active = document.body.classList.contains("campaign-active");
      if (active && canvas.offsetParent !== null && !document.hidden) {
        uniforms.time.value = reduced ? 0 : time / 1000;
        renderer.render(scene, camera);
      }
      frame = window.requestAnimationFrame(render);
    };
    frame = window.requestAnimationFrame(render);
    window.addEventListener("solivate:campaign", (event) => {
      canvas.hidden = !Boolean((event as CustomEvent).detail?.active);
    });
    window.addEventListener("pagehide", () => window.cancelAnimationFrame(frame), { once: true });
  };
  setupThreeFlag();
</script>
<script is:inline define:vars={{ home }}>
  (() => {
    if (window.solivateCampaignBooted) return;
    window.solivateCampaignBooted = true;
    const defaults = JSON.parse(document.getElementById("campaign-defaults")?.textContent || "{}");
    const popup = document.querySelector("[data-campaign-popup]");
    const rail = document.querySelector("[data-campaign-rail]");
    const atmosphere = document.querySelector("[data-campaign-atmosphere]");
    const transition = document.querySelector("[data-campaign-transition]");
    let campaign = defaults;
    let whatsapp = "6281219118993";
    let lastFocused = null;
    let confettiFrame = 0;

    const jakartaDate = () => new Intl.DateTimeFormat("en-CA", {
      timeZone: "Asia/Jakarta", year: "numeric", month: "2-digit", day: "2-digit"
    }).format(new Date());
    const isActive = (value) => Boolean(value?.enabled)
      && jakartaDate() >= String(value.start_date || "0000-00-00")
      && jakartaDate() <= String(value.end_date || "9999-99-99");
    const language = () => document.documentElement.lang === "en" ? "en" : "id";
    const copy = (key) => campaign?.[`${key}_${language()}`] || campaign?.[`${key}_id`] || "";

    const updateCopy = () => {
      const lang = language();
      const amount = Number(campaign.discount_amount || 0).toLocaleString(lang === "en" ? "en-US" : "id-ID");
      const railTitle = rail?.querySelector("[data-campaign-rail-title]");
      const railDetail = rail?.querySelector("p span");
      if (railTitle) railTitle.textContent = lang === "en" ? "Indonesia's 81st Independence Day" : "Promo Merdeka HUT RI ke-81";
      if (railDetail) railDetail.textContent = lang === "en" ? `Save up to Rp${amount}` : `Hemat hingga Rp${amount}`;
      const railLink = rail?.querySelector("a");
      if (railLink) railLink.firstChild.textContent = lang === "en" ? "View promo " : "Lihat promo ";
      const eyebrow = popup?.querySelector("[data-campaign-eyebrow]");
      const headline = popup?.querySelector("[data-campaign-headline]");
      const description = popup?.querySelector("[data-campaign-description]");
      const ctaLabel = popup?.querySelector("[data-campaign-cta-label]");
      const image = popup?.querySelector("[data-campaign-image]");
      const mobile = popup?.querySelector("[data-campaign-mobile-srcset]");
      const cta = popup?.querySelector("[data-campaign-cta]");
      if (eyebrow) eyebrow.textContent = copy("eyebrow");
      if (headline) headline.textContent = copy("headline");
      if (description) description.textContent = copy("description");
      if (ctaLabel) ctaLabel.textContent = copy("cta");
      if (image) { image.src = campaign.desktop_image || defaults.desktop_image; image.alt = copy("image_alt"); }
      if (mobile) mobile.srcset = campaign.mobile_image || campaign.desktop_image || defaults.mobile_image;
      if (cta) cta.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(copy("whatsapp_message"))}`;
    };

    const closePopup = () => {
      if (!popup || popup.hidden) return;
      window.cancelAnimationFrame(confettiFrame);
      popup.classList.remove("is-open");
      document.body.classList.remove("campaign-popup-open");
      window.setTimeout(() => { popup.hidden = true; }, 280);
      lastFocused?.focus?.();
    };

    const celebratePopup = () => {
      if (!popup || popup.dataset.celebrated || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const party = window.solivateParty;
      if (!party) {
        window.addEventListener("solivate:party-ready", celebratePopup, { once: true });
        return;
      }
      popup.dataset.celebrated = "true";
      const source = popup.querySelector(".campaign-popup-mark") || popup;
      const colors = ["#e5232a", "#ffffff", "#b5121b", "#023e8a", "#d7ff3f"];
      const flag = document.createElement("span");
      flag.className = "campaign-party-flag";
      party.confetti(source, {
        count: party.variation.range(window.innerWidth < 640 ? 90 : 150, window.innerWidth < 640 ? 120 : 190),
        spread: party.variation.range(58, 82),
        speed: party.variation.range(360, 680),
        size: party.variation.range(.72, 1.28),
        color: () => party.Color.fromHex(colors[Math.floor(Math.random() * colors.length)]),
        shapes: ["rectangle", "circle", "star", flag]
      });

      const canvas = popup.querySelector("[data-campaign-confetti-canvas]");
      const context = canvas?.getContext?.("2d");
      if (!canvas || !context) return;
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      const width = window.innerWidth;
      const height = window.innerHeight;
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      const pieces = Array.from({ length: width < 640 ? 72 : 118 }, (_, index) => ({
        x: Math.random() * width,
        y: -30 - Math.random() * height * .7,
        size: 4 + Math.random() * 8,
        speed: 1.5 + Math.random() * 3,
        drift: (Math.random() - .5) * 1.1,
        angle: Math.random() * Math.PI,
        spin: (Math.random() - .5) * .16,
        flag: index % 8 === 0,
        color: colors[index % colors.length]
      }));
      const started = performance.now();
      const draw = (now) => {
        context.clearRect(0, 0, width, height);
        pieces.forEach((piece) => {
          piece.y += piece.speed;
          piece.x += piece.drift;
          piece.angle += piece.spin;
          context.save();
          context.translate(piece.x, piece.y);
          context.rotate(piece.angle);
          if (piece.flag) {
            context.fillStyle = "#e5232a";
            context.fillRect(-piece.size, -piece.size * .62, piece.size * 2, piece.size * .62);
            context.fillStyle = "#ffffff";
            context.fillRect(-piece.size, 0, piece.size * 2, piece.size * .62);
          } else {
            context.fillStyle = piece.color;
            context.fillRect(-piece.size * .55, -piece.size * .22, piece.size * 1.1, piece.size * .44);
          }
          context.restore();
        });
        if (now - started < 5200 && !popup.hidden) confettiFrame = window.requestAnimationFrame(draw);
        else context.clearRect(0, 0, width, height);
      };
      confettiFrame = window.requestAnimationFrame(draw);
    };

    const openPopup = () => {
      if (!home || !popup || !isActive(campaign)) return;
      lastFocused = document.activeElement;
      popup.hidden = false;
      document.body.classList.add("campaign-popup-open");
      window.requestAnimationFrame(() => {
        popup.classList.add("is-open");
        window.setTimeout(celebratePopup, 160);
      });
      popup.querySelector("[data-campaign-close]")?.focus();
    };
    const apply = (value) => {
      campaign = { ...defaults, ...(value || {}) };
      const active = isActive(campaign);
      window.solivateCampaign = { ...campaign, active };
      document.body.classList.toggle("campaign-active", active);
      if (rail) rail.hidden = !active;
      if (atmosphere) atmosphere.hidden = !active;
      if (transition) {
        transition.hidden = !active;
        if (active && !transition.dataset.mounted) {
          document.querySelector("main > section:first-child")?.insertAdjacentElement("afterend", transition);
          transition.dataset.mounted = "true";
        }
      }
      updateCopy();
      window.dispatchEvent(new CustomEvent("solivate:campaign", { detail: window.solivateCampaign }));
      if (active && home) openPopup();
      if (!active) closePopup();
    };

    popup?.querySelector("[data-campaign-close]")?.addEventListener("click", closePopup);
    popup?.addEventListener("click", (event) => { if (event.target === popup) closePopup(); });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePopup();
      if (event.key !== "Tab" || !popup || popup.hidden) return;
      const focusable = [...popup.querySelectorAll('button, a[href]')];
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    new MutationObserver(updateCopy).observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });

    fetch("/api/public/cms", { cache: "no-store" })
      .then((response) => response.ok ? response.json() : null)
      .then((data) => {
        whatsapp = String(data?.entries?.contact_whatsapp || whatsapp).replace(/\D/g, "") || whatsapp;
        apply(data?.campaign || defaults);
      })
      .catch(() => apply(defaults));
  })();
</script>
